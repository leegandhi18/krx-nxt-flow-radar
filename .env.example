# ==========================================
# 1. 서버 및 실행 환경 설정
# ==========================================
NODE_ENV=development
TZ=Asia/Seoul
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ==========================================
# 2. PostgreSQL & Redis (docker-compose.yaml 일치)
# ==========================================
DATABASE_URL=postgresql://dev:devpassword@localhost:5432/krx_flow
REDIS_URL=redis://localhost:6379

# ==========================================
# 3. 키움증권 REST API (수급 랭킹 · 일별 확정 수급)
# ==========================================
# 사용 모드 선택: real(실전) | mock(모의)
KIWOOM_ENV=real

# 실전투자 키 및 엔드포인트
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000
KIWOOM_APP_KEY=여기에_키움_실전_APP_KEY_입력
KIWOOM_SECRET_KEY=여기에_키움_실전_SECRET_KEY_입력

# 모의투자 키 및 엔드포인트 (선택)
KIWOOM_MOCK_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_MOCK_WS_URL=wss://mockapi.kiwoom.com:10000
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=

# ==========================================
# 4. 한국투자증권 KIS Open API (실시간 체결가 · 체결강도 · VWAP)
# ==========================================
# 사용 모드 선택: real(실전) | mock(모의)
KIS_ENV=real

# 실전투자 키 및 엔드포인트
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WS_URL=ws://ops.koreainvestment.com:21000
KIS_APP_KEY=여기에_한투_실전_APP_KEY_입력
KIS_APP_SECRET=여기에_한투_실전_APP_SECRET_입력

# 모의투자 키 및 엔드포인트 (선택)
KIS_MOCK_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_MOCK_WS_URL=ws://ops.koreainvestment.com:31000
KIS_MOCK_APP_KEY=
KIS_MOCK_SECRET_KEY=

# ==========================================
# 5. Google Gemini AI & 수집 워커 파라미터
# ==========================================
# Google AI Studio에서 발급받은 AIza... 형식의 API 키 (전 종목 섹터·밸류체인 분류용)
GEMINI_API_KEY=여기에_GEMINI_API_KEY_입력

# 정규장 수급 랭킹 폴링 주기 (밀리초, 기본 20000 = 20초)
RANK_POLL_INTERVAL_MS=20000
# 한투 WebSocket 동시 구독 최대 종목 수 (한도 41건 이내 안전치)
MAX_WS_SUBSCRIPTIONS=40
